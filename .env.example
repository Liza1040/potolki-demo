# ─────────────────────────────────────────────────────────────────────────
# Скопируйте этот файл в .env.local и заполните значения.
# .env.local в git не попадает — он в .gitignore.
# На Vercel те же переменные задаются в Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────

# ЗАЯВКИ В TELEGRAM
# Обе переменные обязательны, иначе отправка не включится.
# Без них заявка пишется в лог сервера и возвращает успех —
# сайт работает, но заявки никуда не уходят.
#
# Где взять:
#   1. TELEGRAM_BOT_TOKEN — напишите @BotFather команду /newbot,
#      он вернёт токен вида 1234567890:AAF...
#   2. TELEGRAM_CHAT_ID — добавьте бота в нужный чат (или напишите ему
#      в личку), затем откройте
#      https://api.telegram.org/bot<ТОКЕН>/getUpdates
#      и возьмите значение result[0].message.chat.id
#      Для группы id отрицательный, это нормально.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ЯНДЕКС.МЕТРИКА
# Только номер счётчика, без кавычек: 98765432
# Пусто — счётчик не подключается, скрипт не грузится, сайт работает.
#
# Где взять: metrika.yandex.ru → Добавить счётчик → номер в списке.
# Цели создавать вручную НЕ нужно как JavaScript-события — они уже
# отправляются кодом: quiz_start, quiz_step_complete, quiz_submit,
# form_submit. В Метрике заведите цели типа «JavaScript-событие»
# с этими идентификаторами.
NEXT_PUBLIC_METRIKA_ID=

# АДРЕС САЙТА
# Нужен для canonical, og:url, sitemap.xml и robots.txt.
# Без него используется заглушка https://pervyi-metr.example,
# и ссылки в OG и sitemap будут вести в никуда.
# Формат: https://домен.ru — без слэша на конце.
NEXT_PUBLIC_SITE_URL=
